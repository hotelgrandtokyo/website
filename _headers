# Static Assets - 1 Year Cache
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.ico
  Cache-Control: public, max-age=31536000, immutable

# Stylesheets and Scripts - 1 Year Cache
/*.css
  Cache-Control: public, max-age=31536000, immutable
/*.js
  Cache-Control: public, max-age=31536000, immutable

# HTML Pages - 1 Hour Cache (allows for updates without long waits)
/*.html
  Cache-Control: public, max-age=3600, must-revalidate

# Specifically for the logo in root
/logo.png
  Cache-Control: public, max-age=31536000, immutable
